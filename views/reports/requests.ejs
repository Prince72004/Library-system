<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/alerts') %>

<div class="container-fluid px-lg-4 py-4 flex-grow-1">
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
      <span class="badge bg-warning text-dark fw-bold">SERVICE REQUEST ANALYTICS (FR-010)</span>
      <h3 class="fw-bold text-dark mb-0">Service Request Statistics & Audit</h3>
      <p class="text-muted small mb-0">Operational performance, request resolution throughput, and patron satisfaction tracking</p>
    </div>
    <div class="d-flex gap-2">
      <a href="/reports/requests?format=csv" class="btn btn-outline-success btn-sm fw-semibold">
        <i class="bi bi-file-earmark-excel me-1"></i> Export to CSV
      </a>
      <button onclick="window.print()" class="btn btn-outline-secondary btn-sm no-print">
        <i class="bi bi-printer me-1"></i> Print Report
      </button>
      <a href="/reports" class="btn btn-outline-primary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Reports Home
      </a>
    </div>
  </div>

  <!-- KPI Cards -->
  <div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm rounded-4 card-kpi card-kpi-primary">
        <div class="card-body p-3">
          <span class="text-muted small fw-semibold">TOTAL REQUESTS</span>
          <h3 class="fw-bold text-dark my-1"><%= totalCount %></h3>
          <small class="text-muted">Lifetime requests received</small>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm rounded-4 card-kpi card-kpi-warning">
        <div class="card-body p-3">
          <span class="text-muted small fw-semibold">PENDING REVIEW</span>
          <h3 class="fw-bold text-warning my-1"><%= pendingCount %></h3>
          <small class="text-muted">Awaiting action</small>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm rounded-4 card-kpi card-kpi-success">
        <div class="card-body p-3">
          <span class="text-muted small fw-semibold">RESOLVED / FULFILLED</span>
          <h3 class="fw-bold text-success my-1"><%= resolvedCount %></h3>
          <small class="text-muted">Successfully handled</small>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm rounded-4 card-kpi card-kpi-danger">
        <div class="card-body p-3">
          <span class="text-muted small fw-semibold">REJECTED</span>
          <h3 class="fw-bold text-danger my-1"><%= rejectedCount %></h3>
          <small class="text-muted">Ineligible or duplicate</small>
        </div>
      </div>
    </div>
  </div>

  <!-- Requests Table -->
  <div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
      <% if (requests.length === 0) { %>
        <div class="text-center py-5">
          <i class="bi bi-inbox fs-1 text-muted mb-3 d-block"></i>
          <h5 class="fw-bold">No Requests Recorded</h5>
          <p class="text-muted">No service requests exist in the system yet.</p>
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead>
              <tr>
                <th class="ps-4">Request ID</th>
                <th>Requester</th>
                <th>Request Type</th>
                <th>Target / Suggestion</th>
                <th>Submitted Date</th>
                <th>Status</th>
                <th class="pe-4">Staff Remarks</th>
              </tr>
            </thead>
            <tbody>
              <% requests.forEach(function(r) { %>
                <tr>
                  <td class="ps-4">
                    <span class="badge bg-light text-dark border code-font fs-8"><%= r.requestId %></span>
                  </td>
                  <td>
                    <div class="fw-semibold text-dark"><%= r.userId ? r.userId.name : 'Unknown' %></div>
                    <small class="text-muted"><%= r.userId ? r.userId.email : '' %></small>
                  </td>
                  <td>
                    <span class="badge bg-secondary-subtle text-secondary fw-semibold"><%= r.type %></span>
                  </td>
                  <td>
                    <% if (r.type === 'SUGGESTION') { %>
                      <div class="fw-semibold text-dark"><%= r.suggestedTitle %></div>
                      <small class="text-muted"><%= r.suggestedAuthor ? 'By ' + r.suggestedAuthor : 'New Title Suggestion' %></small>
                    <% } else if (r.bookId) { %>
                      <div class="fw-semibold text-dark"><%= r.bookId.title %></div>
                      <small class="text-muted">By <%= r.bookId.author %></small>
                    <% } else { %>
                      <span class="text-muted small"><%= r.details %></span>
                    <% } %>
                  </td>
                  <td>
                    <small class="text-muted"><%= new Date(r.submittedAt).toLocaleDateString() %></small>
                  </td>
                  <td>
                    <% if (r.status === 'PENDING') { %>
                      <span class="badge badge-pending px-2 py-1">PENDING</span>
                    <% } else if (r.status === 'APPROVED') { %>
                      <span class="badge badge-approved px-2 py-1">APPROVED</span>
                    <% } else if (r.status === 'RESOLVED') { %>
                      <span class="badge badge-resolved px-2 py-1">RESOLVED</span>
                    <% } else { %>
                      <span class="badge badge-rejected px-2 py-1">REJECTED</span>
                    <% } %>
                  </td>
                  <td class="pe-4">
                    <small class="text-dark"><%= r.staffRemarks || 'N/A' %></small>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
