<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/alerts') %>

<div class="container-fluid px-lg-4 py-4 flex-grow-1">
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
      <span class="badge bg-primary-subtle text-primary fw-bold">OPERATIONAL REPORT (FR-010)</span>
      <h3 class="fw-bold text-dark mb-0">Active Issued Books Report</h3>
      <p class="text-muted small mb-0">Detailed list of all books currently checked out to patrons</p>
    </div>
    <div class="d-flex gap-2">
      <a href="/reports/circulation?format=csv" class="btn btn-outline-success btn-sm fw-semibold">
        <i class="bi bi-file-earmark-excel me-1"></i> Export to CSV
      </a>
      <button onclick="window.print()" class="btn btn-outline-secondary btn-sm no-print">
        <i class="bi bi-printer me-1"></i> Print Report
      </button>
      <a href="/reports" class="btn btn-outline-primary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Reports Home
      </a>
    </div>
  </div>

  <div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
      <% if (issues.length === 0) { %>
        <div class="text-center py-5">
          <i class="bi bi-journal-check fs-1 text-success mb-3 d-block"></i>
          <h5 class="fw-bold">No Active Issues</h5>
          <p class="text-muted">All catalog copies are currently present in the library.</p>
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead>
              <tr>
                <th class="ps-4">Circulation ID</th>
                <th>Patron Name</th>
                <th>Email / Contact</th>
                <th>Book Title</th>
                <th>Copy ID</th>
                <th>Issue Date</th>
                <th>Due Date</th>
                <th class="pe-4">Status</th>
              </tr>
            </thead>
            <tbody>
              <% issues.forEach(function(item) { %>
                <% const isOverdue = new Date() > new Date(item.dueDate); %>
                <tr>
                  <td class="ps-4">
                    <span class="badge bg-light text-dark border code-font fs-8"><%= item.circulationId %></span>
                  </td>
                  <td>
                    <div class="fw-semibold text-dark"><%= item.userId ? item.userId.name : 'Unknown' %></div>
                    <small class="text-muted"><%= item.userId ? item.userId.userId : '' %></small>
                  </td>
                  <td>
                    <small class="text-dark"><%= item.userId ? item.userId.email : 'N/A' %></small>
                    <% if (item.userId && item.userId.phone) { %>
                      <small class="text-muted d-block"><%= item.userId.phone %></small>
                    <% } %>
                  </td>
                  <td>
                    <div class="fw-semibold text-dark"><%= item.bookId ? item.bookId.title : 'Book' %></div>
                    <small class="text-muted code-font"><%= item.bookId ? item.bookId.bookId : '' %></small>
                  </td>
                  <td>
                    <span class="badge bg-dark text-white code-font fs-8"><i class="bi bi-upc-scan me-1"></i><%= item.copyCode || 'Standard' %></span>
                  </td>
                  <td>
                    <small class="text-dark"><%= new Date(item.issueDate).toLocaleDateString() %></small>
                  </td>
                  <td>
                    <small class="<%= isOverdue ? 'text-danger fw-bold' : 'text-dark' %>"><%= new Date(item.dueDate).toLocaleDateString() %></small>
                  </td>
                  <td class="pe-4">
                    <% if (isOverdue) { %>
                      <span class="badge bg-danger">Overdue</span>
                    <% } else { %>
                      <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Active</span>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
