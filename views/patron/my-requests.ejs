<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/alerts') %>

<div class="container-fluid px-lg-4 py-4 flex-grow-1">
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
      <span class="badge bg-primary-subtle text-primary fw-bold">REQUEST TRACKING (FR-006)</span>
      <h3 class="fw-bold text-dark mb-0">My Service Requests</h3>
      <p class="text-muted small mb-0">Real-time status updates and staff remarks for your submitted requests</p>
    </div>
    <div>
      <a href="/patron/request-submit" class="btn btn-primary btn-sm fw-semibold shadow-sm">
        <i class="bi bi-plus-circle me-1"></i> New Request
      </a>
    </div>
  </div>

  <!-- Filters -->
  <div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
      <form action="/patron/my-requests" method="GET" class="d-flex flex-wrap align-items-center gap-2">
        <span class="fw-semibold small text-muted me-2"><i class="bi bi-funnel me-1"></i>Filter by Status:</span>
        <a href="/patron/my-requests" class="btn btn-sm <%= selectedStatus === 'ALL' ? 'btn-primary' : 'btn-outline-secondary' %>">All</a>
        <a href="/patron/my-requests?status=PENDING" class="btn btn-sm <%= selectedStatus === 'PENDING' ? 'btn-warning text-dark' : 'btn-outline-secondary' %>">Pending</a>
        <a href="/patron/my-requests?status=APPROVED" class="btn btn-sm <%= selectedStatus === 'APPROVED' ? 'btn-info text-white' : 'btn-outline-secondary' %>">Approved</a>
        <a href="/patron/my-requests?status=RESOLVED" class="btn btn-sm <%= selectedStatus === 'RESOLVED' ? 'btn-success' : 'btn-outline-secondary' %>">Resolved</a>
        <a href="/patron/my-requests?status=REJECTED" class="btn btn-sm <%= selectedStatus === 'REJECTED' ? 'btn-danger' : 'btn-outline-secondary' %>">Rejected</a>
      </form>
    </div>
  </div>

  <!-- Requests Table / List -->
  <div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
      <% if (requests.length === 0) { %>
        <div class="text-center py-5">
          <i class="bi bi-inbox fs-1 text-muted mb-3 d-block"></i>
          <h5 class="fw-bold">No Requests Found</h5>
          <p class="text-muted">You have no requests matching the current filter.</p>
          <a href="/patron/request-submit" class="btn btn-outline-primary btn-sm mt-2">Submit New Request</a>
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead>
              <tr>
                <th class="ps-4">Request ID</th>
                <th>Type</th>
                <th>Subject / Target Book</th>
                <th>Details / Reason</th>
                <th>Submitted Date</th>
                <th>Status</th>
                <th class="pe-4">Staff Remarks</th>
              </tr>
            </thead>
            <tbody>
              <% requests.forEach(function(r) { %>
                <tr>
                  <td class="ps-4">
                    <span class="badge bg-light text-dark border code-font fs-8"><%= r.requestId %></span>
                  </td>
                  <td>
                    <span class="badge bg-secondary-subtle text-secondary fw-semibold"><%= r.type %></span>
                  </td>
                  <td>
                    <% if (r.type === 'SUGGESTION') { %>
                      <div class="fw-semibold text-dark"><%= r.suggestedTitle %></div>
                      <small class="text-muted"><%= r.suggestedAuthor ? 'By ' + r.suggestedAuthor : 'New Title Suggestion' %></small>
                    <% } else if (r.bookId) { %>
                      <div class="fw-semibold text-dark"><%= r.bookId.title %></div>
                      <small class="text-muted">By <%= r.bookId.author %></small>
                    <% } else if (r.circulationId && r.circulationId.bookId) { %>
                      <div class="fw-semibold text-dark"><%= r.circulationId.bookId.title %></div>
                      <small class="text-muted">Active Loan Renewal</small>
                    <% } else { %>
                      <span class="text-muted small">General Request</span>
                    <% } %>
                  </td>
                  <td style="max-width: 250px;">
                    <div class="small text-truncate-2" title="<%= r.details %>"><%= r.details %></div>
                  </td>
                  <td>
                    <small class="text-muted"><%= new Date(r.submittedAt).toLocaleDateString() %></small>
                  </td>
                  <td>
                    <% if (r.status === 'PENDING') { %>
                      <span class="badge badge-pending px-2 py-1"><i class="bi bi-hourglass-split me-1"></i>PENDING</span>
                    <% } else if (r.status === 'APPROVED') { %>
                      <span class="badge badge-approved px-2 py-1"><i class="bi bi-check-circle me-1"></i>APPROVED</span>
                    <% } else if (r.status === 'RESOLVED') { %>
                      <span class="badge badge-resolved px-2 py-1"><i class="bi bi-patch-check-fill me-1"></i>RESOLVED</span>
                    <% } else { %>
                      <span class="badge badge-rejected px-2 py-1"><i class="bi bi-x-circle me-1"></i>REJECTED</span>
                    <% } %>
                  </td>
                  <td class="pe-4">
                    <% if (r.staffRemarks) { %>
                      <span class="small text-dark fw-medium"><i class="bi bi-chat-dots text-primary me-1"></i><%= r.staffRemarks %></span>
                    <% } else { %>
                      <span class="text-muted small fst-italic">Awaiting staff review</span>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
