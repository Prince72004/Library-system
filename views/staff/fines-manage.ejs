<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/alerts') %>

<div class="container-fluid px-lg-4 py-4 flex-grow-1">
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
      <span class="badge bg-warning text-dark fw-bold">FINE SETTLEMENT (FR-007)</span>
      <h3 class="fw-bold text-dark mb-0">Library Overdue Fines & Penalties</h3>
      <p class="text-muted small mb-0">Monitor overdue penalties, process in-person fine payments, and manage fee waivers</p>
    </div>
    <div>
      <a href="/reports/fines" class="btn btn-outline-secondary btn-sm fw-semibold">
        <i class="bi bi-file-earmark-spreadsheet me-1"></i> Fines Report & Export
      </a>
    </div>
  </div>

  <!-- Summary Cards -->
  <div class="row g-3 mb-4">
    <div class="col-md-6">
      <div class="card border-0 shadow-sm rounded-4 card-kpi card-kpi-danger">
        <div class="card-body p-4 d-flex justify-content-between align-items-center">
          <div>
            <span class="text-muted small fw-semibold">TOTAL PENDING UNCOLLECTED FINES</span>
            <h2 class="fw-bold text-danger my-1">₹ <%= totalPending %></h2>
            <small class="text-muted">Awaiting student/patron desk settlement</small>
          </div>
          <div class="p-3 bg-danger bg-opacity-10 text-danger rounded-circle">
            <i class="bi bi-cash-stack fs-2"></i>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-6">
      <div class="card border-0 shadow-sm rounded-4 card-kpi card-kpi-success">
        <div class="card-body p-4 d-flex justify-content-between align-items-center">
          <div>
            <span class="text-muted small fw-semibold">TOTAL COLLECTED & PAID FINES</span>
            <h2 class="fw-bold text-success my-1">₹ <%= totalPaid %></h2>
            <small class="text-muted">Cleared and documented in library accounts</small>
          </div>
          <div class="p-3 bg-success bg-opacity-10 text-success rounded-circle">
            <i class="bi bi-check-circle fs-2"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Filter -->
  <div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
      <div class="d-flex flex-wrap align-items-center gap-2">
        <span class="small fw-semibold text-muted me-2"><i class="bi bi-funnel me-1"></i>Filter by Status:</span>
        <a href="/staff/fines" class="btn btn-sm <%= selectedStatus === 'ALL' ? 'btn-primary' : 'btn-outline-secondary' %>">All Fines</a>
        <a href="/staff/fines?status=PENDING" class="btn btn-sm <%= selectedStatus === 'PENDING' ? 'btn-danger text-white' : 'btn-outline-secondary' %>">Pending</a>
        <a href="/staff/fines?status=PAID" class="btn btn-sm <%= selectedStatus === 'PAID' ? 'btn-success' : 'btn-outline-secondary' %>">Paid</a>
        <a href="/staff/fines?status=WAIVED" class="btn btn-sm <%= selectedStatus === 'WAIVED' ? 'btn-secondary' : 'btn-outline-secondary' %>">Waived</a>
      </div>
    </div>
  </div>

  <!-- Fines Table -->
  <div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
      <% if (fines.length === 0) { %>
        <div class="text-center py-5">
          <i class="bi bi-shield-check fs-1 text-success mb-3 d-block"></i>
          <h5 class="fw-bold">No Fine Records Found</h5>
          <p class="text-muted">No fines match your current filter.</p>
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead>
              <tr>
                <th class="ps-4">Fine ID</th>
                <th>Patron Details</th>
                <th>Target Book / Circulation</th>
                <th>Reason</th>
                <th>Amount (Rs)</th>
                <th>Status</th>
                <th>Assessed Date</th>
                <th class="pe-4 text-end">Action</th>
              </tr>
            </thead>
            <tbody>
              <% fines.forEach(function(f) { %>
                <tr>
                  <td class="ps-4">
                    <span class="badge bg-light text-dark border code-font fs-8"><%= f.fineId %></span>
                  </td>
                  <td>
                    <% if (f.userId) { %>
                      <div class="fw-semibold text-dark"><%= f.userId.name %></div>
                      <small class="text-muted"><%= f.userId.email %> &bull; <code class="text-primary"><%= f.userId.userId %></code></small>
                    <% } else { %>
                      <span class="text-muted">Unknown Patron</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (f.circulationId && f.circulationId.bookId) { %>
                      <div class="fw-semibold text-dark"><%= f.circulationId.bookId.title %></div>
                      <small class="text-muted code-font"><%= f.circulationId.circulationId %></small>
                    <% } else { %>
                      <span class="text-muted small">Circulation reference</span>
                    <% } %>
                  </td>
                  <td>
                    <span class="small text-dark"><%= f.reason %></span>
                  </td>
                  <td>
                    <span class="fw-bold text-<%= f.status === 'PENDING' ? 'danger' : 'success' %>">₹ <%= f.amount %></span>
                  </td>
                  <td>
                    <% if (f.status === 'PENDING') { %>
                      <span class="badge bg-danger-subtle text-danger border border-danger-subtle">PENDING</span>
                    <% } else if (f.status === 'PAID') { %>
                      <span class="badge bg-success-subtle text-success border border-success-subtle">PAID</span>
                    <% } else { %>
                      <span class="badge bg-secondary-subtle text-secondary border">WAIVED</span>
                    <% } %>
                  </td>
                  <td>
                    <small class="text-muted"><%= new Date(f.createdAt).toLocaleDateString() %></small>
                  </td>
                  <td class="pe-4 text-end">
                    <% if (f.status === 'PENDING') { %>
                      <button type="button" class="btn btn-sm btn-primary fw-semibold" data-bs-toggle="modal" data-bs-target="#settleModal-<%= f._id %>">
                        Settle Fee
                      </button>

                      <!-- Modal for Settlement -->
                      <div class="modal fade" id="settleModal-<%= f._id %>" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered text-start">
                          <div class="modal-content rounded-4 border-0 shadow">
                            <form action="/staff/fines/<%= f._id %>/status" method="POST">
                              <div class="modal-header border-0 pb-0">
                                <h5 class="modal-title fw-bold">
                                  <i class="bi bi-cash-coin text-primary me-2"></i>Settle Fine Payment
                                </h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                              </div>
                              <div class="modal-body py-3">
                                <div class="p-3 bg-light rounded-3 mb-3">
                                  <div><strong>Patron:</strong> <%= f.userId ? f.userId.name : 'Patron' %></div>
                                  <div><strong>Fine Amount:</strong> <span class="text-danger fw-bold fs-5">₹ <%= f.amount %></span></div>
                                  <div class="text-muted small"><strong>Reason:</strong> <%= f.reason %></div>
                                </div>

                                <div class="mb-3">
                                  <label class="form-label small fw-semibold">Settlement Decision <span class="text-danger">*</span></label>
                                  <select class="form-select form-select-sm" name="status" required>
                                    <option value="PAID">Mark as PAID (Cash / UPI collected at desk)</option>
                                    <option value="WAIVED">Mark as WAIVED (Librarian special exemption)</option>
                                  </select>
                                </div>

                                <div class="mb-3">
                                  <label class="form-label small fw-semibold">Receipt / Note</label>
                                  <input type="text" class="form-control form-control-sm" name="remarks" placeholder="Receipt number or reason for waiver...">
                                </div>
                              </div>
                              <div class="modal-footer border-0 pt-0">
                                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-success btn-sm fw-semibold">Confirm Settlement</button>
                              </div>
                            </form>
                          </div>
                        </div>
                      </div>
                    <% } else { %>
                      <small class="text-muted"><%= f.remarks || 'Settled' %></small>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
