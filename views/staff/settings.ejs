<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/alerts') %>

<div class="container py-4 flex-grow-1">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4 p-md-5">
          <div class="d-flex align-items-center gap-3 mb-4">
            <div class="p-3 bg-secondary bg-opacity-10 text-dark rounded-circle">
              <i class="bi bi-sliders fs-2"></i>
            </div>
            <div>
              <span class="badge bg-secondary text-white fw-bold">SYSTEM CONFIGURATION</span>
              <h3 class="fw-bold text-dark mb-0">Library Borrowing Rules & Settings</h3>
              <p class="text-muted small mb-0">Tune circulation limits, loan periods, and overdue penalty rates</p>
            </div>
          </div>

          <form action="/staff/settings" method="POST">
            <div class="row g-4">
              <!-- Maximum Books Per Patron -->
              <div class="col-md-6">
                <label for="maxBooksPerPatron" class="form-label fw-bold">Max Books Allowed per Patron <span class="text-danger">*</span></label>
                <div class="input-group">
                  <input type="number" class="form-control" id="maxBooksPerPatron" name="maxBooksPerPatron" value="<%= config.maxBooksPerPatron %>" min="1" max="10" required>
                  <span class="input-group-text bg-light">Books</span>
                </div>
                <small class="text-muted">Prevents patrons from exceeding maximum simultaneous loans.</small>
              </div>

              <!-- Default Loan Period -->
              <div class="col-md-6">
                <label for="loanPeriodDays" class="form-label fw-bold">Standard Loan Period <span class="text-danger">*</span></label>
                <div class="input-group">
                  <input type="number" class="form-control" id="loanPeriodDays" name="loanPeriodDays" value="<%= config.loanPeriodDays %>" min="1" max="90" required>
                  <span class="input-group-text bg-light">Days</span>
                </div>
                <small class="text-muted">Default borrowing duration assigned at book issue or renewal.</small>
              </div>

              <!-- Daily Overdue Fine Rate -->
              <div class="col-md-6">
                <label for="fineRatePerDay" class="form-label fw-bold">Overdue Fine Rate <span class="text-danger">*</span></label>
                <div class="input-group">
                  <span class="input-group-text bg-light">₹</span>
                  <input type="number" class="form-control" id="fineRatePerDay" name="fineRatePerDay" value="<%= config.fineRatePerDay %>" min="0" step="0.5" required>
                  <span class="input-group-text bg-light">/ Day</span>
                </div>
                <small class="text-muted">Applied automatically when overdue books are returned.</small>
              </div>

              <!-- Institution / Library Name -->
              <div class="col-md-6">
                <label for="libraryName" class="form-label fw-bold">Library Name Header</label>
                <input type="text" class="form-control" id="libraryName" name="libraryName" value="<%= config.libraryName %>" required>
                <small class="text-muted">Displayed across reports and receipts.</small>
              </div>

              <div class="col-12">
                <div class="p-3 bg-light rounded-3 border">
                  <h6 class="fw-bold text-dark mb-1"><i class="bi bi-info-circle text-primary me-1"></i>Notification Delivery Mechanism (SRS Section 2.4)</h6>
                  <p class="text-muted small mb-0">
                    In-app reactive notifications are active for all patrons (due date reminders at &le; 3 days, instant overdue alerts upon date expiry, and service request approval/rejection updates).
                  </p>
                </div>
              </div>

              <div class="col-12 d-flex justify-content-between align-items-center pt-3 border-top">
                <a href="/staff/dashboard" class="btn btn-outline-secondary">
                  <i class="bi bi-arrow-left me-1"></i> Dashboard
                </a>
                <button type="submit" class="btn btn-primary px-4 fw-semibold shadow-sm">
                  <i class="bi bi-save me-1"></i> Save Configuration
                </button>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
