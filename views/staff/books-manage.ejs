<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/alerts') %>

<div class="container-fluid px-lg-4 py-4 flex-grow-1">
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
      <span class="badge bg-primary-subtle text-primary fw-bold">CATALOG MANAGEMENT</span>
      <h3 class="fw-bold text-dark mb-0">Book Inventory & Catalog</h3>
      <p class="text-muted small mb-0">Add, update, search, and monitor physical book stock copies</p>
    </div>
    <div class="d-flex gap-2">
      <a href="/staff/books/add" class="btn btn-primary btn-sm fw-semibold shadow-sm">
        <i class="bi bi-plus-lg me-1"></i> Add New Book
      </a>
      <a href="/catalog" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-eye me-1"></i> Patron View
      </a>
    </div>
  </div>

  <!-- Search Filter -->
  <div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
      <form action="/staff/books" method="GET" class="row g-2 align-items-center">
        <div class="col-md-10">
          <div class="input-group">
            <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
            <input type="text" class="form-control" name="search" value="<%= searchQuery %>" placeholder="Search by title, author, category, ISBN, or Book ID...">
          </div>
        </div>
        <div class="col-md-2 d-flex gap-2">
          <button type="submit" class="btn btn-primary w-100 fw-semibold">Search</button>
          <a href="/staff/books" class="btn btn-outline-secondary" title="Reset Search"><i class="bi bi-arrow-counterclockwise"></i></a>
        </div>
      </form>
    </div>
  </div>

  <!-- Books Table -->
  <div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
      <% if (books.length === 0) { %>
        <div class="text-center py-5">
          <i class="bi bi-journal-x fs-1 text-muted mb-3 d-block"></i>
          <h5 class="fw-bold">No Books Found</h5>
          <p class="text-muted">No books matched your search criteria.</p>
          <a href="/staff/books/add" class="btn btn-primary btn-sm mt-2">Add Your First Book</a>
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead>
              <tr>
                <th class="ps-4">Book ID</th>
                <th>Title & Author</th>
                <th>Category</th>
                <th>Shelf Location</th>
                <th>Stock / Copies</th>
                <th>Status</th>
                <th class="pe-4 text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% books.forEach(function(b) { %>
                <tr>
                  <td class="ps-4">
                    <span class="badge bg-light text-dark border code-font fs-8"><%= b.bookId %></span>
                  </td>
                  <td>
                    <div class="fw-semibold text-dark"><%= b.title %></div>
                    <small class="text-muted">By <%= b.author %> <%= b.isbn ? '• ISBN: ' + b.isbn : '' %></small>
                  </td>
                  <td>
                    <span class="badge bg-secondary-subtle text-secondary"><%= b.category %></span>
                  </td>
                  <td>
                    <small class="text-dark"><i class="bi bi-geo-alt text-primary me-1"></i><%= b.shelfLocation || 'Main Stack' %></small>
                  </td>
                  <td>
                    <span class="fw-bold text-<%= b.availableCopies > 0 ? 'success' : 'danger' %>"><%= b.availableCopies %></span>
                    <span class="text-muted small">/ <%= b.totalCopies %> total</span>
                  </td>
                  <td>
                    <% if (b.availableCopies > 0) { %>
                      <span class="badge bg-success-subtle text-success border border-success-subtle">Available</span>
                    <% } else { %>
                      <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Checked Out</span>
                    <% } %>
                  </td>
                  <td class="pe-4 text-end">
                    <div class="btn-group btn-group-sm">
                      <a href="/staff/books/<%= b._id %>/copies" class="btn btn-outline-primary" title="Manage Physical Copies">
                        <i class="bi bi-upc-scan me-1"></i> Copies (<%= b.totalCopies %>)
                      </a>
                      <a href="/staff/books/edit/<%= b._id %>" class="btn btn-outline-secondary" title="Edit Book">
                        <i class="bi bi-pencil"></i>
                      </a>
                      <a href="/staff/circulation/issue?bookId=<%= b._id %>" class="btn btn-outline-success <%= b.availableCopies <= 0 ? 'disabled' : '' %>" title="Issue Book">
                        <i class="bi bi-box-arrow-up-right"></i>
                      </a>
                      <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#delModal-<%= b._id %>" title="Delete Book">
                        <i class="bi bi-trash"></i>
                      </button>
                    </div>

                    <!-- Delete Modal -->
                    <div class="modal fade" id="delModal-<%= b._id %>" tabindex="-1" aria-hidden="true">
                      <div class="modal-dialog modal-dialog-centered text-start">
                        <div class="modal-content rounded-4 border-0 shadow">
                          <form action="/staff/books/delete/<%= b._id %>" method="POST">
                            <div class="modal-header border-0 pb-0">
                              <h5 class="modal-title fw-bold text-danger">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>Delete Book?
                              </h5>
                              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body py-3">
                              Are you sure you want to remove <strong>"<%= b.title %>"</strong> (<%= b.bookId %>) from the library catalog? This action cannot be undone.
                            </div>
                            <div class="modal-footer border-0 pt-0">
                              <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                              <button type="submit" class="btn btn-danger btn-sm fw-semibold">Delete Permanently</button>
                            </div>
                          </form>
                        </div>
                      </div>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
