<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/alerts') %>

<div class="container py-5 flex-grow-1">
  <div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">

      <div class="mb-4">
        <a href="/staff/users?role=STAFF" class="btn btn-outline-secondary btn-sm">
          <i class="bi bi-arrow-left me-1"></i> Back to Users
        </a>
      </div>

      <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4 p-md-5">

          <div class="text-center mb-4">
            <div class="d-inline-flex p-3 rounded-circle bg-warning bg-opacity-10 text-warning mb-3">
              <i class="bi bi-person-badge fs-1"></i>
            </div>
            <h4 class="fw-bold">Add New Staff Account</h4>
            <p class="text-muted small">Create a new library staff or admin account</p>
          </div>

          <form action="/staff/users/add-staff" method="POST">

            <div class="mb-3">
              <label class="form-label fw-semibold">Full Name <span class="text-danger">*</span></label>
              <div class="input-group">
                <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
                <input type="text" class="form-control" name="name" placeholder="e.g. Dr. Mohd. Raza" required>
              </div>
            </div>

            <div class="mb-3">
              <label class="form-label fw-semibold">Email Address <span class="text-danger">*</span></label>
              <div class="input-group">
                <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                <input type="email" class="form-control" name="email" placeholder="name@amu.ac.in" required>
              </div>
            </div>

            <div class="mb-3">
              <label class="form-label fw-semibold">Password <span class="text-danger">*</span></label>
              <div class="input-group">
                <span class="input-group-text bg-light"><i class="bi bi-key"></i></span>
                <input type="password" class="form-control" name="password" placeholder="Min. 6 characters" required minlength="6">
              </div>
            </div>

            <div class="mb-3">
              <label class="form-label fw-semibold">Phone Number</label>
              <div class="input-group">
                <span class="input-group-text bg-light"><i class="bi bi-telephone"></i></span>
                <input type="text" class="form-control" name="phone" placeholder="+91XXXXXXXXXX">
              </div>
            </div>

            <div class="mb-4">
              <label class="form-label fw-semibold">Department</label>
              <div class="input-group">
                <span class="input-group-text bg-light"><i class="bi bi-building"></i></span>
                <input type="text" class="form-control" name="department" placeholder="e.g. Library Administration" value="Library Administration">
              </div>
            </div>

            <div class="alert alert-warning d-flex gap-2 align-items-start py-2">
              <i class="bi bi-shield-exclamation mt-1"></i>
              <small>This account will have <strong>full STAFF access</strong> — including issuing books, managing users, and viewing reports.</small>
            </div>

            <button type="submit" class="btn btn-warning w-100 fw-semibold py-2 mt-2">
              <i class="bi bi-person-plus me-2"></i> Create Staff Account
            </button>
          </form>

        </div>
      </div>

    </div>
  </div>
</div>

<%- include('../partials/footer') %>
