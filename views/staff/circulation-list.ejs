<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/alerts') %>

<div class="container-fluid px-lg-4 py-4 flex-grow-1">
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
      <span class="badge bg-primary-subtle text-primary fw-bold">CIRCULATION LEDGER (FR-003)</span>
      <h3 class="fw-bold text-dark mb-0">Circulation Transactions History</h3>
      <p class="text-muted small mb-0">Complete record of all issue and return transactions</p>
    </div>
    <div class="d-flex gap-2">
      <a href="/staff/circulation/issue" class="btn btn-success btn-sm fw-semibold">
        <i class="bi bi-box-arrow-up-right me-1"></i> Issue Book
      </a>
      <a href="/staff/circulation/return" class="btn btn-warning btn-sm fw-semibold text-dark">
        <i class="bi bi-box-arrow-in-down-left me-1"></i> Return Book
      </a>
    </div>
  </div>

  <!-- Status Filter Pills -->
  <div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
      <div class="d-flex flex-wrap align-items-center gap-2">
        <span class="small fw-semibold text-muted me-2"><i class="bi bi-funnel me-1"></i>Status Filter:</span>
        <a href="/staff/circulation" class="btn btn-sm <%= selectedStatus === 'ALL' ? 'btn-primary' : 'btn-outline-secondary' %>">All Records</a>
        <a href="/staff/circulation?status=ISSUED" class="btn btn-sm <%= selectedStatus === 'ISSUED' ? 'btn-primary' : 'btn-outline-secondary' %>">Active Issues</a>
        <a href="/staff/circulation?status=RETURNED" class="btn btn-sm <%= selectedStatus === 'RETURNED' ? 'btn-success' : 'btn-outline-secondary' %>">Returned</a>
      </div>
    </div>
  </div>

  <!-- Circulations Table -->
  <div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
      <% if (circulations.length === 0) { %>
        <div class="text-center py-5">
          <i class="bi bi-journal-x fs-1 text-muted mb-3 d-block"></i>
          <h5 class="fw-bold">No Circulation Records Found</h5>
          <p class="text-muted">No transactions have been recorded under this filter.</p>
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead>
              <tr>
                <th class="ps-4">Transaction ID</th>
                <th>Patron</th>
                <th>Book Title</th>
                <th>Issue Date</th>
                <th>Due Date</th>
                <th>Return Date</th>
                <th>Status</th>
                <th class="pe-4">Fine</th>
              </tr>
            </thead>
            <tbody>
              <% circulations.forEach(function(c) { %>
                <% const isOverdue = !c.returnDate && (new Date() > new Date(c.dueDate)); %>
                <tr>
                  <td class="ps-4">
                    <span class="badge bg-light text-dark border code-font fs-8"><%= c.circulationId %></span>
                  </td>
                  <td>
                    <% if (c.userId) { %>
                      <div class="fw-semibold text-dark"><%= c.userId.name %></div>
                      <small class="text-muted"><%= c.userId.email %> &bull; <code class="text-primary"><%= c.userId.userId %></code></small>
                    <% } else { %>
                      <span class="text-muted">Unknown User</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (c.bookId) { %>
                      <div class="fw-semibold text-dark"><%= c.bookId.title %></div>
                      <small class="text-muted code-font"><%= c.bookId.bookId %></small>
                      <% if (c.copyCode) { %>
                        <span class="badge bg-dark text-white code-font fs-8 ms-1"><i class="bi bi-upc-scan me-1"></i><%= c.copyCode %></span>
                      <% } %>
                    <% } else { %>
                      <span class="text-muted">Unknown Book</span>
                    <% } %>
                  </td>
                  <td>
                    <small class="text-dark"><%= new Date(c.issueDate).toLocaleDateString() %></small>
                  </td>
                  <td>
                    <small class="<%= isOverdue ? 'text-danger fw-bold' : 'text-dark' %>"><%= new Date(c.dueDate).toLocaleDateString() %></small>
                  </td>
                  <td>
                    <% if (c.returnDate) { %>
                      <small class="text-success"><i class="bi bi-check-circle me-1"></i><%= new Date(c.returnDate).toLocaleDateString() %></small>
                    <% } else { %>
                      <span class="badge bg-light text-muted border fs-8">Not Returned</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (c.status === 'RETURNED') { %>
                      <span class="badge bg-success-subtle text-success border border-success-subtle">RETURNED</span>
                    <% } else if (isOverdue) { %>
                      <span class="badge bg-danger">OVERDUE</span>
                    <% } else { %>
                      <span class="badge bg-primary-subtle text-primary border border-primary-subtle">ISSUED</span>
                    <% } %>
                  </td>
                  <td class="pe-4">
                    <% if (c.fine > 0) { %>
                      <span class="fw-bold text-danger">₹ <%= c.fine %></span>
                    <% } else { %>
                      <span class="text-muted small">₹ 0</span>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
