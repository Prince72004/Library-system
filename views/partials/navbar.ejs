            </a>
          </li>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle <%= typeof page !== 'undefined' && (page === 'request-submit' || page === 'my-requests') ? 'active fw-semibold' : '' %>" href="#" role="button" data-bs-toggle="dropdown">
              <i class="bi bi-card-checklist me-1"></i> Service Requests
            </a>
            <ul class="dropdown-menu dropdown-menu-dark shadow">
              <li><a class="dropdown-item" href="/patron/request-submit"><i class="bi bi-plus-circle me-2 text-primary"></i>Submit New Request</a></li>
