          <!-- Notifications Dropdown (FR-008) -->
          <li class="nav-item dropdown">
            <a class="nav-link position-relative px-2" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" title="Notifications">
              <i class="bi bi-bell fs-5"></i>
              <% if (typeof unreadCount !== 'undefined' && unreadCount > 0) { %>
                <span class="position-absolute top-1 start-100 translate-middle badge rounded-pill bg-danger">
                  <%= unreadCount %>
                  <span class="visually-hidden">unread messages</span>
                </span>
              <% } %>
            </a>
            <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark shadow-lg notification-dropdown" style="min-width: 320px; max-width: 360px;">
