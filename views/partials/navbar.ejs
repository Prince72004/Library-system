            </a>
          </li>
          <li class="nav-item">
            <a class="btn btn-primary btn-sm px-3" href="/auth/register">
              <i class="bi bi-person-plus me-1"></i> Register
            </a>
          </li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>
