        <% } %>

        <% if (user && user.role === 'STAFF') { %>
          <li class="nav-item">
            <a class="nav-link <%= typeof page !== 'undefined' && page === 'staff-dashboard' ? 'active fw-semibold' : '' %>" href="/staff/dashboard">
              <i class="bi bi-grid-1x2-fill me-1"></i> Staff Dashboard
            </a>
          </li>

          <!-- Circulation Dropdown -->
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle <%= typeof page !== 'undefined' && (page === 'issue-book' || page === 'return-book' || page === 'circulations') ? 'active fw-semibold' : '' %>" href="#" role="button" data-bs-toggle="dropdown">
              <i class="bi bi-arrow-left-right me-1"></i> Circulation
            </a>
            <ul class="dropdown-menu dropdown-menu-dark shadow">
              <li><a class="dropdown-item" href="/staff/circulation/issue"><i class="bi bi-box-arrow-up-right me-2 text-success"></i>Issue Book</a></li>
              <li><a class="dropdown-item" href="/staff/circulation/return"><i class="bi bi-box-arrow-in-down-left me-2 text-warning"></i>Return Book</a></li>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item" href="/staff/circulation"><i class="bi bi-list-ul me-2"></i>Circulation History</a></li>
            </ul>
          </li>

