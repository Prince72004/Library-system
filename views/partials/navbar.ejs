                <span class="fw-bold text-white"><i class="bi bi-bell-fill me-1 text-warning"></i> Notifications</span>
                <% if (typeof unreadCount !== 'undefined' && unreadCount > 0) { %>
                  <span class="badge bg-primary rounded-pill"><%= unreadCount %> New</span>
                <% } %>
              </li>
              <div class="notification-list" style="max-height: 280px; overflow-y: auto;">
                <% if (typeof recentNotifications !== 'undefined' && recentNotifications.length > 0) { %>
                  <% recentNotifications.forEach(function(n) { %>
                    <li>
                      <a class="dropdown-item py-2 px-3 border-bottom border-dark text-wrap <%= n.status === 'UNREAD' ? 'bg-secondary bg-opacity-25' : '' %>" href="<%= user.role === 'PATRON' ? '/patron/notifications' : '#' %>">
                        <div class="d-flex w-100 justify-content-between">
                          <strong class="fs-7 text-<%= n.type === 'OVERDUE' ? 'danger' : (n.type === 'DUE_REMINDER' ? 'warning' : 'info') %>">
                            <%= n.title %>
                          </strong>
                          <small class="text-white-50 fs-8"><%= new Date(n.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %></small>
                        </div>
                        <p class="mb-0 fs-8 text-light text-truncate-2"><%= n.message %></p>
                      </a>
                    </li>
                  <% }); %>
                <% } else { %>
                  <li class="py-3 text-center text-white-50 fs-8">No notifications at this time</li>
                <% } %>
              </div>
              <% if (user.role === 'PATRON') { %>
