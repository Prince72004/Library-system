          <li class="nav-item">
            <a class="nav-link <%= typeof page !== 'undefined' && page === 'staff-requests' ? 'active fw-semibold' : '' %>" href="/staff/requests">
              <i class="bi bi-envelope-paper me-1"></i> Service Requests
            </a>
          </li>

