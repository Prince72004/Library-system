<%- include('./partials/header') %>
<%- include('./partials/navbar') %>

<div class="container py-5 text-center flex-grow-1 d-flex flex-column justify-content-center align-items-center">
  <div class="p-4 rounded-circle bg-warning bg-opacity-10 text-warning mb-4">
    <i class="bi bi-exclamation-octagon fs-1"></i>
  </div>
  <h1 class="display-4 fw-bold text-dark">500 - Server Error</h1>
  <p class="lead text-muted mb-4">Something went wrong while processing your request.</p>
  <% if (typeof error !== 'undefined' && error && error.message) { %>
    <div class="alert alert-secondary text-start p-3 code-font small" style="max-width: 600px;">
      <%= error.message %>
    </div>
  <% } %>
  <div class="mt-3">
    <a href="/" class="btn btn-primary px-4 fw-semibold me-2">Back to Home</a>
    <a href="/catalog" class="btn btn-outline-secondary px-4 fw-semibold">View Catalog</a>
  </div>
</div>

<%- include('./partials/footer') %>
