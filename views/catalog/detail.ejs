<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/alerts') %>

<div class="container py-4 flex-grow-1">
  <nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/catalog" class="text-decoration-none">Catalog</a></li>
      <li class="breadcrumb-item"><%= book.category %></li>
      <li class="breadcrumb-item active" aria-current="page"><%= book.title %></li>
    </ol>
  </nav>

  <div class="row g-4">
    <!-- Left Cover Mockup Card -->
    <div class="col-lg-4">
      <div class="card border-0 shadow-sm rounded-4 overflow-hidden text-center p-3 p-md-4">
        <% 
          const cleanIsbnDetail = book.isbn ? book.isbn.replace(/[^0-9Xx]/g, '') : '';
          const fallbackImgDetail = cleanIsbnDetail ? `https://covers.openlibrary.org/b/isbn/${cleanIsbnDetail}-L.jpg` : '';
          const displayImgDetail = book.coverImage && book.coverImage.trim() !== '' ? book.coverImage : fallbackImgDetail;
        %>
        <% if (displayImgDetail) { %>
          <div class="book-detail-cover-wrapper mb-3 rounded-3 overflow-hidden shadow-sm position-relative">
            <img src="<%= displayImgDetail %>" 
                 alt="<%= book.title %>" 
                 class="img-fluid rounded-3 book-detail-cover-img"
                 onerror="this.onerror=null; this.style.display='none'; this.nextElementSibling.classList.remove('d-none');">
            <div class="py-5 bg-dark text-white rounded-3 d-none shadow-inner">
              <i class="bi bi-book-half display-1 text-primary"></i>
              <h5 class="mt-3 px-3 fw-bold text-white"><%= book.title %></h5>
              <span class="badge bg-primary px-3 py-1"><%= book.category %></span>
            </div>
          </div>
        <% } else { %>
          <div class="py-5 bg-dark text-white rounded-3 mb-3 shadow-inner">
            <i class="bi bi-book-half display-1 text-primary"></i>
            <h5 class="mt-3 px-3 fw-bold text-white"><%= book.title %></h5>
            <span class="badge bg-primary px-3 py-1"><%= book.category %></span>
          </div>
        <% } %>

        <div class="d-flex justify-content-around text-center py-2 border-top">
          <div>
            <div class="text-muted small">Total Copies</div>
            <div class="fw-bold fs-5 text-dark"><%= book.totalCopies %></div>
          </div>
          <div class="vr"></div>
          <div>
            <div class="text-muted small">Available</div>
            <div class="fw-bold fs-5 text-<%= book.availableCopies > 0 ? 'success' : 'danger' %>">
              <%= book.availableCopies %>
            </div>
          </div>
          <div class="vr"></div>
          <div>
            <div class="text-muted small">Status</div>
            <span class="badge <%= book.availableCopies > 0 ? 'bg-success' : 'bg-danger' %> mt-1">
              <%= book.availableCopies > 0 ? 'In Stock' : 'Checked Out' %>
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Details Column -->
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4 p-md-5">
          <div class="d-flex justify-content-between align-items-start mb-3">
            <div>
              <span class="badge bg-secondary-subtle text-secondary code-font mb-2">Book ID: <%= book.bookId %></span>
              <h2 class="fw-bold text-dark mb-1"><%= book.title %></h2>
              <p class="text-muted fs-5 mb-0">By <span class="fw-semibold text-dark"><%= book.author %></span></p>
            </div>
          </div>

          <div class="row g-3 py-3 border-top border-bottom my-3">
            <div class="col-sm-6">
              <span class="text-muted small d-block">Shelf / Rack Location:</span>
              <span class="fw-semibold text-dark"><i class="bi bi-geo-alt text-primary me-1"></i><%= book.shelfLocation || 'Department Main Stack' %></span>
            </div>
            <div class="col-sm-6">
              <span class="text-muted small d-block">ISBN Number:</span>
              <span class="fw-semibold text-dark code-font"><i class="bi bi-upc text-primary me-1"></i><%= book.isbn || 'N/A' %></span>
            </div>
            <div class="col-sm-6">
              <span class="text-muted small d-block">Publisher:</span>
              <span class="fw-semibold text-dark"><i class="bi bi-building text-primary me-1"></i><%= book.publisher || 'Academic Press' %></span>
            </div>
            <div class="col-sm-6">
              <span class="text-muted small d-block">Edition:</span>
              <span class="fw-semibold text-dark"><i class="bi bi-bookmark text-primary me-1"></i><%= book.edition || 'Latest Edition' %></span>
            </div>
          </div>

          <div class="mb-4">
            <h6 class="fw-bold text-dark">Description / Overview</h6>
            <p class="text-muted">
              <%= book.description || 'This book is cataloged in the Computer Science Library collection for academic study and research.' %>
            </p>
          </div>

          <!-- Physical Copies Availability Table (Mentor Feature) -->
          <div class="mb-4">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <h6 class="fw-bold text-dark mb-0"><i class="bi bi-upc-scan me-2 text-primary"></i>Individual Physical Copies Registry (<%= copies ? copies.length : 0 %>)</h6>
              <% if (user && user.role === 'STAFF') { %>
                <a href="/staff/books/<%= book._id %>/copies" class="btn btn-outline-primary btn-sm py-0">
                  <i class="bi bi-gear me-1"></i> Manage Copies
                </a>
              <% } %>
            </div>
            <% if (typeof copies !== 'undefined' && copies.length > 0) { %>
              <div class="table-responsive border rounded-3 bg-white">
                <table class="table table-sm table-hover align-middle mb-0">
                  <thead class="table-light">
                    <tr>
                      <th class="ps-3">Copy ID</th>
                      <th>Location</th>
                      <th>Status</th>
                      <th class="pe-3 text-end">Availability / Holder</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% copies.forEach(function(c) { %>
                      <tr>
                        <td class="ps-3">
                          <code class="fw-bold text-dark"><%= c.copyId %></code>
                          <small class="text-muted">(#<%= c.copyNumber %>)</small>
                        </td>
                        <td>
                          <small class="text-muted"><i class="bi bi-geo-alt"></i> <%= c.shelfLocation || book.shelfLocation %></small>
                        </td>
                        <td>
                          <% if (c.status === 'AVAILABLE') { %>
                            <span class="badge bg-success-subtle text-success border border-success-subtle fs-8">AVAILABLE</span>
                          <% } else if (c.status === 'ISSUED') { %>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-8">ISSUED</span>
                          <% } else { %>
                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle fs-8"><%= c.status %></span>
                          <% } %>
                        </td>
                        <td class="pe-3 text-end">
                          <% if (c.status === 'AVAILABLE') { %>
                            <span class="text-success small fw-semibold"><i class="bi bi-check2"></i> On Shelf</span>
                          <% } else if (c.status === 'ISSUED' && c.currentCirculationId) { %>
                            <% if (user && user.role === 'STAFF' && c.currentCirculationId.userId) { %>
                              <small class="text-primary fw-semibold"><i class="bi bi-person"></i> <%= c.currentCirculationId.userId.name %> (Due: <%= new Date(c.currentCirculationId.dueDate).toLocaleDateString() %>)</small>
                            <% } else { %>
                              <small class="text-muted">Due: <%= new Date(c.currentCirculationId.dueDate).toLocaleDateString() %></small>
                            <% } %>
                          <% } else { %>
                            <small class="text-muted"><%= c.conditionNotes || 'Unavailable' %></small>
                          <% } %>
                        </td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
            <% } %>
          </div>

          <!-- User Actions / Status -->
          <div class="p-3 bg-light rounded-3 border">
            <% if (user && user.role === 'PATRON') { %>
              <% if (userActiveLoan) { %>
                <div class="alert alert-info mb-2 d-flex align-items-center">
                  <i class="bi bi-info-circle-fill me-2 fs-5"></i>
                  <div>
                    <strong>You currently have this book issued!</strong>
                    Due date: <%= new Date(userActiveLoan.dueDate).toLocaleDateString() %>.
                  </div>
                </div>
                <a href="/patron/request-submit?type=RENEWAL&circulationId=<%= userActiveLoan._id %>" class="btn btn-warning fw-semibold">
                  <i class="bi bi-arrow-repeat me-1"></i> Request Loan Renewal
                </a>
              <% } else if (userPendingReservation) { %>
                <div class="alert alert-warning mb-0 d-flex align-items-center">
                  <i class="bi bi-hourglass-split me-2 fs-5"></i>
                  <div>
                    You have a <strong>pending reservation</strong> for this book (<%= userPendingReservation.requestId %>).
                    <a href="/patron/my-requests" class="alert-link ms-1">Track request status</a>.
                  </div>
                </div>
              <% } else { %>
                <div class="d-flex flex-wrap gap-2">
                  <a href="/patron/request-submit?type=RESERVATION&bookId=<%= book._id %>" class="btn btn-primary fw-semibold">
                    <i class="bi bi-bookmark-plus me-1"></i> <%= book.availableCopies > 0 ? 'Place Reservation' : 'Join Hold Queue' %>
                  </a>
                  <a href="/patron/request-submit?type=COMPLAINT&bookId=<%= book._id %>" class="btn btn-outline-danger fw-semibold">
                    <i class="bi bi-flag me-1"></i> Report Damage / Issue
                  </a>
                </div>
              <% } %>
            <% } else if (user && user.role === 'STAFF') { %>
              <div class="d-flex flex-wrap gap-2">
                <% if (book.availableCopies > 0) { %>
                  <a href="/staff/circulation/issue?bookId=<%= book._id %>" class="btn btn-success fw-semibold">
                    <i class="bi bi-box-arrow-up-right me-1"></i> Issue Book to Patron
                  </a>
                <% } %>
                <a href="/staff/books/edit/<%= book._id %>" class="btn btn-outline-secondary fw-semibold">
                  <i class="bi bi-pencil me-1"></i> Edit Catalog Details
                </a>
              </div>
            <% } else { %>
              <div class="d-flex align-items-center justify-content-between">
                <span class="text-muted small">Please sign in to reserve or borrow this book.</span>
                <a href="/auth/login" class="btn btn-primary btn-sm fw-semibold">Sign In to Request</a>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
